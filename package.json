{
  "name": "deemus-mcp",
  "version": "0.11.0",
  "description": "Deemus MCP Server",
  "main": "dist/http.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/http.js",
    "dev": "HOST=127.0.0.1 ts-node --esm src/http.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "version": "node scripts/sync-plugin-version.mjs && git add src/plugin/.claude-plugin/plugin.json src/plugin/.codex-plugin/plugin.json"
  },
  "keywords": [
    "mcp",
    "deemus",
    "ai",
    "judgment"
  ],
  "author": "mizulba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizulba-dev/deemus-mcp.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "4.1.12"
  }
}
